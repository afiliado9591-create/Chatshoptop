{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/conteudo/([^/]+)/?",
      "dest": "/api/content.js?slug=$1"
    },
    {
      "src": "/produto/([^/]+)/?",
      "dest": "/api/app.js?product=$1"
    },
    {
      "src": "/",
      "dest": "/api/app.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
