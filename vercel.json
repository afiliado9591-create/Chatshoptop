{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/content.js": {
      "includeFiles": [
        "index.html",
        "virtual-chat-description-fix.js",
        "qna-source-patcher.js"
      ]
    }
  },
  "headers": [
    {
      "source": "/product-seller-button-control.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/qna-matcher.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/index.html",
      "dest": "/api/content.js?qnaSource=index"
    },
    {
      "src": "/virtual-chat-description-fix.js",
      "dest": "/api/content.js?qnaSource=virtual"
    },
    {
      "src": "/site/?",
      "dest": "/api/public-page.js?slug=inicio"
    },
    {
      "src": "/p/([^/]+)/?",
      "dest": "/api/public-page.js?slug=$1"
    },
    {
      "src": "/conteudo/([^/]+)/?",
      "dest": "/api/content.js?slug=$1"
    },
    {
      "src": "/quem-somos/?",
      "dest": "/api/store-affiliate-page.js?page=about"
    },
    {
      "src": "/politica-de-privacidade/?",
      "dest": "/api/store-affiliate-page.js?page=privacy"
    },
    {
      "src": "/afiliados/?",
      "dest": "/api/store-affiliate-page.js"
    },
    {
      "src": "/produto/([^/]+)/?",
      "dest": "/api/app-superfrete.js?product=$1"
    },
    {
      "src": "/",
      "dest": "/api/app-superfrete.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
