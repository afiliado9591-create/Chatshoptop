{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/product-seller-button-control.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/catalog-seller-simplify.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/meus-pedidos/?",
      "dest": "/api/app-superfrete.js?orders=1"
    },
    {
      "src": "/site/?",
      "dest": "/api/public-page.js?slug=inicio"
    },
    {
      "src": "/p/([^/]+)/?",
      "dest": "/api/public-page.js?slug=$1"
    },
    {
      "src": "/conteudo/([^/]+)/?",
      "dest": "/api/content.js?slug=$1"
    },
    {
      "src": "/quem-somos/?",
      "dest": "/api/store-affiliate-page.js?page=about"
    },
    {
      "src": "/politica-de-privacidade/?",
      "dest": "/api/store-affiliate-page.js?page=privacy"
    },
    {
      "src": "/afiliados/?",
      "dest": "/api/store-affiliate-page.js"
    },
    {
      "src": "/post/([^/]+)/?",
      "dest": "/api/app-superfrete.js"
    },
    {
      "src": "/perfil/([^/]+)/?",
      "dest": "/api/app-superfrete.js"
    },
    {
      "src": "/produto/([^/]+)/?",
      "dest": "/api/app-superfrete.js?product=$1"
    },
    {
      "src": "/",
      "dest": "/api/app-superfrete.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
